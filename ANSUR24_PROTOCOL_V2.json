  "compatibility": {
    "ANSUR24-PROT-v1": "historical measurement/influence evidence only; not relabeled",
    "solver24PriorV1": "candidate-ranking hint only; prior kick disabled",
    "anthro24ConditionalPriorV1": "retained for ANSUR target-vector consistency, not mesh geometry"
  },
  "scientificBoundary": [
    "respiration is metadata unless a volumetric breathing model exists",
    "max-effort muscle contraction is metadata unless a validated deformation model exists",
    "instrument pressure is represented only by explicitly documented proxy operators",
    "palm-up/palm-forward twist remains unresolved where exact forearm roll is not validated"
  ],
  "solverWeighting": {
    "method": "relative allowable-observer-error normalization",
    "formula": "rowWeight = medianAllowableErrorCm / allowableObserverErrorCm",
    "statisticalInterpretation": "engineering protocol weighting only; allowable observer errors are not sigma or variances",
    "acceptance": "cm RMSE remains reported; protocol units are also gated/exported"
  }
